# TypeSafe / Jev API key from https://console.typesafe.ai/keys (server-side only, never sent to the browser)
TYPESAFE_API_KEY=

# true  -> always use recorded evaluator responses (no network, always works)
# false -> call TypeSafe live when TYPESAFE_API_KEY is set (falls back to recorded responses on error)
DEMO_MODE=true
